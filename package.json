{
  "name": "lanchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline decentralized LAN messenger",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:desktop": "node scripts/smoke.mjs",
    "test:lrdt": "node scripts/run-lrdt-tests.mjs",
    "benchmark": "node --import tsx scripts/benchmarks/run.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "playwright": "^1.56.0"
  }
}
